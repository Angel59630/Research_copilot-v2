APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

DATABASE_URL=sqlite+aiosqlite:///./data/research_copilot.db

DATA_DIR=./data
LOG_DIR=./data/logs
CHROMA_DIR=./data/chroma

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=bge-m3

# 可以直接填写密钥
API_KEY=

# 也可以引用 Windows 环境变量
# API_KEY={DS_API_KEY}

MAX_PDF_MB=50
MAX_PDF_PAGES=500

INGESTION_WORKERS=2

CHUNK_SIZE=1200
CHUNK_OVERLAP=200

RAG_TOP_K=12
MAX_TOOL_CALLS=2

AUTO_COMPRESS_TOKENS=250000
RECENT_CONTEXT_TOKENS=50000